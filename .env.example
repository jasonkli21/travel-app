# Shared local defaults
OWNER_ID=local

# Backend
DATABASE_URL=postgresql+psycopg://travel:travel@localhost:5432/travel
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000
PERSONAL_AI_BASE_URL=http://localhost:8001
PERSONAL_AI_TIMEOUT_SECONDS=45
PERSONAL_AI_RESEARCH_ENABLED=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,::1
GEOAPIFY_API_KEY=
GEOAPIFY_TIMEOUT_SECONDS=8

# Frontend configuration lives in frontend/.env.local.
# Copy frontend/.env.example to frontend/.env.local for Next.js.
