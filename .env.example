# Shared local defaults
OWNER_ID=local
TRAVEL_AUTH_MODE=local
# Configure these only after an operator provisions a Google OAuth web client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_ALLOWED_EMAIL=
# Required for a non-Gmail owner; must match the verified Google hd claim.
GOOGLE_OAUTH_ALLOWED_HOSTED_DOMAIN=
GOOGLE_OIDC_ISSUER=https://accounts.google.com
AUTH_SESSION_TTL_SECONDS=28800
# Local-only private source ingress remains disabled unless Google OIDC is
# configured and a private directory outside this repository is provisioned.
PRIVATE_IMPORTS_ENABLED=false
# General trip attachments use the same private local store and require Google OIDC.
PRIVATE_ATTACHMENTS_ENABLED=false
PRIVATE_SOURCE_DIR=

# Backend
DATABASE_URL=postgresql+psycopg://travel:travel@localhost:5432/travel
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000
PERSONAL_AI_BASE_URL=http://localhost:8001
PERSONAL_AI_TIMEOUT_SECONDS=45
PERSONAL_AI_RESEARCH_ENABLED=false
PERSONAL_AI_COMPARISONS_ENABLED=false
PERSONAL_AI_PROPOSALS_ENABLED=false
# Private Cloud Run AI transport is a separate external enablement gate.
PERSONAL_AI_AUTH_MODE=none
PERSONAL_AI_USER_ID_TOKEN_AUDIENCE=
PERSONAL_AI_SERVICE_IAM_AUDIENCE=
# Only set for an explicitly configured Cloud Run custom audience.
PERSONAL_AI_ALLOW_CUSTOM_SERVICE_AUDIENCE=false
PERSONAL_AI_SERVICE_ACCOUNT=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,::1
GEOAPIFY_API_KEY=
GEOAPIFY_TIMEOUT_SECONDS=8

# Frontend configuration lives in frontend/.env.local.
# Copy frontend/.env.example to frontend/.env.local for Next.js.
