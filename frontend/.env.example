# Server-only backend URL used by the Next.js API proxy.
TRAVEL_API_URL=http://localhost:8000
TRAVEL_WEB_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# In Google mode, Google redirects to this same-origin Next route. The backend
# Google redirect URI must match the HTTPS production callback exactly.
# Google OAuth credentials belong in the backend's server-only environment.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=

# Browser-visible Geoapify map-tile key; restrict it to the local web origin.
# Production builds bake this value in; rebuild after changing it.
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# Keep proposal controls hidden unless the local UI is explicitly enabled.
# The travel API also requires PERSONAL_AI_PROPOSALS_ENABLED=true.
NEXT_PUBLIC_TRAVEL_PROPOSALS_ENABLED=false
# Keep typed Phase 7 comparison controls hidden unless the travel API is also
# configured with PERSONAL_AI_COMPARISONS_ENABLED=true.
NEXT_PUBLIC_TRAVEL_COMPARISONS_ENABLED=false
# Keep booking-document intake hidden unless private imports have been reviewed.
# The travel API also requires PRIVATE_IMPORTS_ENABLED=true and verified auth.
NEXT_PUBLIC_PRIVATE_IMPORTS_ENABLED=false
