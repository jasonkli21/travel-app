# Server-only backend URL used by the Next.js API proxy.
TRAVEL_API_URL=http://localhost:8000
TRAVEL_WEB_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Browser-visible Geoapify map-tile key; restrict it to the local web origin.
# Production builds bake this value in; rebuild after changing it.
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# Keep proposal controls hidden unless the local UI is explicitly enabled.
# The travel API also requires PERSONAL_AI_PROPOSALS_ENABLED=true.
NEXT_PUBLIC_TRAVEL_PROPOSALS_ENABLED=false
